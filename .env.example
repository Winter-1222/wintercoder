# 使用方法：复制为项目根目录的 .env，再填写真实 Key；.env 已被 Git 忽略，禁止提交。
# Python Bridge 会主动加载“当前项目根目录/.env”，而且其中的同名值优先于系统环境变量。
# 没有 .env 时仍默认使用 fake；本模板用于连接正式模型，所以这里写 configured。
JIXUE_LLM_MODE=configured
JIXUE_MODEL_ID=flash

# 只在复制出来的 .env 中填写真实值，不要修改和提交本示例文件中的空值。
DEEPSEEK_API_KEY=

# 第六章连接高德 MCP 时再配置。
AMAP_MCP_KEY=
